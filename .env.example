# Steam Web API Key (Get yours from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=YOUR_STEAM_API_KEY_HERE

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cs2_scrims?schema=public

# Redis Connection (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# Secret key for JWT signing & verification (generate a secure random 32+ char string)
JWT_SECRET=super_secret_jwt_key_cs2_scrim_league_at_least_32_chars_long

# Base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord Webhook URL for global notifications & match alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/dummy/webhook

# Comma-separated 64-bit Steam IDs granted ADMIN role on login / seed
ADMIN_STEAM_IDS=76561198000000001,76561198000000002

# Local upload directory for team logos & attachments
UPLOAD_DIR=./uploads

# Server Port
PORT=3000
